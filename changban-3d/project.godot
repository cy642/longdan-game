config_version=5

[application]
config/name="龙胆：逆命三国 · 长坂坡 3D"
config/version="0.2.0"
run/main_scene="res://longdan.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/ui/longdan.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.075,0.098,0.098,1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
environment/defaults/default_clear_color=Color(0.54,0.67,0.70,1)

[physics]
common/physics_ticks_per_second=60

[debug]
gdscript/warnings/inference_on_variant=0
